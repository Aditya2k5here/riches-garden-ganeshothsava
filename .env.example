# Copy to .env.local for development, and set the same keys in Vercel.
# Everything here is public by definition (NEXT_PUBLIC_*) — never put a
# secret, API key or password in this file or in any NEXT_PUBLIC_ variable.

# Canonical origin. Used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://richesgarden.example

# Google Form for children's event registration. While this is empty the
# site shows "Registration opens soon" instead of a dead button.
NEXT_PUBLIC_REGISTRATION_FORM_URL=

# UPI details shown in the donations section. Leave blank and the panel
# falls back to "speak to a committee member".
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE=Riches Garden Ganeshothsava Committee
