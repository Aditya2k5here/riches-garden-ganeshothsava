/**
 * Builds the Riches Garden Ganeshothsava stage events registration form.
 *
 * Run `build()` once from the Apps Script editor bound to the form. It is
 * idempotent: it clears every existing item first, so re-running after a
 * change to this file rebuilds the form cleanly rather than duplicating it.
 *
 * Kept in the repository so the form is reproducible. If it is ever deleted
 * or has to be rebuilt for 2027, this is the source of truth — change the
 * dates at the top and run it again.
 *
 * What is deliberately NOT here: the theme, the colours and the header
 * banner. Apps Script cannot set those; they are configured in the Forms UI
 * and the banner is generated by scripts/make-form-header.mjs.
 */

var FORM_ID = "1pihsV8OTcloNs_WG-tMydpMQc7d3e-D0rNYR4kwUDVM";

var FESTIVAL = "Riches Garden Ganeshothsava 2026";
var DATES = "18 · 19 · 20 September 2026";
var CONTACT = "Srinivas V — 7259816679 (Cultural Activities)";

var CATEGORIES = [
  "Singing",
  "Dance",
  "Bharatanatyam",
  "Drama",
  "Group Performance",
  "Other Cultural Event",
];

var DURATIONS = ["2 minutes", "3 minutes", "4 minutes", "5 minutes", "6 minutes", "7 minutes"];

function build() {
  var form = FormApp.openById(FORM_ID);

  form.setTitle("Stage Events Registration");
  form.setDescription(
    FESTIVAL +
      "\n" +
      DATES +
      "\n\n" +
      "Open to every child in Riches Garden, individually or as a group.\n\n" +
      "Preferred duration 2–5 minutes. Maximum 7 minutes.\n" +
      "Registration closes two days before the event.\n\n" +
      "The performance order is decided by the committee after registrations " +
      "close and is shared on the website and in the WhatsApp group.\n\n" +
      "Questions: " +
      CONTACT,
  );

  // Start clean so re-running never duplicates anything.
  var items = form.getItems();
  for (var i = items.length - 1; i >= 0; i--) {
    form.deleteItem(items[i]);
  }

  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setAllowResponseEdits(true);
  form.setPublishingSummary(false);
  form.setConfirmationMessage(
    "Registration received — thank you.\n\n" +
      "The committee will confirm your slot and publish the performance " +
      "order after registrations close. Approximate timings are shared then; " +
      "please have your child ready three performances ahead on the day.\n\n" +
      CONTACT,
  );

  // --- routing -------------------------------------------------------------
  // Page navigation has to point at pages that already exist, so the two
  // branches are created first and the chooser is wired up afterwards.

  var individual = form.addPageBreakItem().setTitle("Individual performance");
  buildIndividual(form);

  var group = form.addPageBreakItem().setTitle("Group performance");
  buildGroup(form);

  // Both branches end the form rather than running into each other.
  individual.setGoToPage(FormApp.PageNavigationType.SUBMIT);

  var chooser = form
    .addMultipleChoiceItem()
    .setTitle("Are you registering as an individual or a group?")
    .setRequired(true);

  chooser.setChoices([
    chooser.createChoice("Individual", individual),
    chooser.createChoice("Group", group),
  ]);

  // The chooser is added last, so move it to the top.
  form.moveItem(form.getItems().length - 1, 0);

  Logger.log("Built: " + form.getPublishedUrl());
}

/** Fields common to both branches, in the same order for both. */
function addPerformanceFields(form, who) {
  var category = form
    .addMultipleChoiceItem()
    .setTitle("Event category")
    .setRequired(true);
  category.setChoiceValues(CATEGORIES);

  form
    .addTextItem()
    .setTitle("Performance or song name")
    .setHelpText("What will be performed — the song, dance or piece.")
    .setRequired(true);

  var duration = form
    .addMultipleChoiceItem()
    .setTitle("Preferred duration")
    .setHelpText("2–5 minutes is preferred. 7 minutes is the maximum.")
    .setRequired(true);
  duration.setChoiceValues(DURATIONS);

  // Optional on purpose: Google requires a signed-in Google account to
  // upload, which not every parent will have to hand. Anyone who cannot
  // upload can send the track to the cultural activities number instead.
  form
    .addFileUploadItem()
    .setTitle("Song or audio track")
    .setHelpText(
      "Optional. If you cannot upload here, send the track on WhatsApp to " +
        CONTACT +
        ".",
    )
    .setRequired(false);

  form
    .addParagraphTextItem()
    .setTitle("Anything the committee should know")
    .setHelpText("Props, stage setup, timing requests. Optional.")
    .setRequired(false);

  var confirm = form
    .addCheckboxItem()
    .setTitle("Please confirm")
    .setRequired(true);
  confirm.setChoiceValues([
    "I understand the maximum stage time is 7 minutes",
    "I understand the committee decides the final performance order",
  ]);
  confirm.setValidation(
    FormApp.createCheckboxValidation().requireSelectAtLeast(2).build(),
  );
}

function buildIndividual(form) {
  form
    .addTextItem()
    .setTitle("Child's full name")
    .setRequired(true);

  form
    .addTextItem()
    .setTitle("Father's or guardian's name")
    .setRequired(true);

  form
    .addTextItem()
    .setTitle("Age")
    .setRequired(true)
    .setValidation(
      FormApp.createTextValidation()
        .requireNumberBetween(2, 25)
        .setHelpText("Enter an age between 2 and 25.")
        .build(),
    );

  form
    .addTextItem()
    .setTitle("Contact number")
    .setHelpText("A WhatsApp number the committee can reach on the day.")
    .setRequired(true)
    .setValidation(
      FormApp.createTextValidation()
        .requireTextMatchesPattern("[0-9+\\s-]{10,15}")
        .setHelpText("Enter a valid phone number.")
        .build(),
    );

  addPerformanceFields(form, "individual");
}

function buildGroup(form) {
  form.addTextItem().setTitle("Group name").setRequired(true);

  form.addTextItem().setTitle("Group leader's name").setRequired(true);

  form
    .addTextItem()
    .setTitle("Group leader's father's or guardian's name")
    .setRequired(true);

  form
    .addTextItem()
    .setTitle("Contact number")
    .setHelpText("A WhatsApp number the committee can reach on the day.")
    .setRequired(true)
    .setValidation(
      FormApp.createTextValidation()
        .requireTextMatchesPattern("[0-9+\\s-]{10,15}")
        .setHelpText("Enter a valid phone number.")
        .build(),
    );

  form
    .addTextItem()
    .setTitle("Number of participants")
    .setRequired(true)
    .setValidation(
      FormApp.createTextValidation()
        .requireNumberBetween(2, 40)
        .setHelpText("Enter a number between 2 and 40.")
        .build(),
    );

  form
    .addParagraphTextItem()
    .setTitle("Participant names and ages")
    .setHelpText("One per line, for example: Ananya Rao — 9")
    .setRequired(true);

  addPerformanceFields(form, "group");
}

/* -------------------------------------------------------------------------
   REFERENCE NUMBERS  (optional — enable when the committee wants them)

   Run `installReferenceNumbers()` once after the form has a linked response
   sheet. Every submission then gets a reference like RG-3344 written into a
   column, which is what the committee quotes back to a parent.

   Numbers are sequential from the row, not random, so two submissions can
   never collide.
   ------------------------------------------------------------------------- */

function installReferenceNumbers() {
  var form = FormApp.openById(FORM_ID);
  var sheetId = form.getDestinationId();
  if (!sheetId) {
    throw new Error(
      "Link a response spreadsheet first: Responses tab, then the Sheets icon.",
    );
  }

  // Avoid stacking duplicate triggers if this is run more than once.
  var existing = ScriptApp.getProjectTriggers();
  for (var i = 0; i < existing.length; i++) {
    if (existing[i].getHandlerFunction() === "onFormSubmit") {
      ScriptApp.deleteTrigger(existing[i]);
    }
  }

  ScriptApp.newTrigger("onFormSubmit").forForm(form).onFormSubmit().create();
  Logger.log("Reference numbers enabled.");
}

function onFormSubmit(e) {
  var sheet = SpreadsheetApp.openById(
    FormApp.openById(FORM_ID).getDestinationId(),
  ).getSheets()[0];

  var header = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  var column = header.indexOf("Reference") + 1;

  if (column === 0) {
    column = sheet.getLastColumn() + 1;
    sheet.getRange(1, column).setValue("Reference");
  }

  var row = sheet.getLastRow();
  // 3300 + row keeps the numbers four digits and human-readable.
  sheet.getRange(row, column).setValue("RG-" + (3300 + row));
}
